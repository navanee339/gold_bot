# Copy to .env (local dev) or /etc/goldbot/goldbot.env (server).
# Never commit the real file.

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_BotFather

# ── Rate data source ─────────────────────────────────────────────────
# Configure ONE of the two sources. If both are set, RATES_URL wins unless
# RATES_SOURCE says otherwise.
# RATES_SOURCE=drive

# Option A — Google Drive (your current pipeline)
GDRIVE_CREDENTIALS_FILE=/etc/goldbot/credentials.json
GDRIVE_FOLDER_ID=your_folder_id
# Date is appended automatically: gold_rates_india_YYYY-MM-DD.json
GDRIVE_FILE_BASE=gold_rates_india

# Option B — GitHub feed (Phase 2)
# Private repo (set RATES_TOKEN below too):
# RATES_URL=https://api.github.com/repos/YOUR_USER/gold_bot/contents/data/latest.json
# Public repo:
# RATES_URL=https://raw.githubusercontent.com/YOUR_USER/gold_bot/main/data/latest.json

# Optional: only needed if the rates repo is PRIVATE.
# Fine-grained PAT with contents:read on that repo.
# RATES_TOKEN=

# How often to re-fetch the rates file, in minutes.
RATES_REFRESH_MINUTES=60

# Refuse rates older than this many days — catches a scraper that stopped.
RATES_MAX_AGE_DAYS=3

# ── Storage ──────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use the local JSON file (subscribers.json).
# Set it to switch to Postgres — nothing else changes.
# DATABASE_URL=postgresql:///goldbot?host=/var/run/postgresql

# ── Behaviour ────────────────────────────────────────────────────────
DEFAULT_CITY=Chennai
DAILY_QUERY_LIMIT=50

# Daily broadcast time, IST (24h)
DAILY_MESSAGE_HOUR=10
DAILY_MESSAGE_MINUTE=0
